    "mode": "synthetic",
    "engine": "vllm",
    "version": "0.19.0",
    "model": "synthetic/qwen3",
    "pattern": "none",
    "stream": false,
    "expect": { "detected": false, "pattern": null, "recovered": false },
    "request": {
      "messages": [
        { "role": "system", "content": "You are a helpful assistant with access to tools." },
        { "role": "user", "content": "What is the weather in Tokyo?" }
