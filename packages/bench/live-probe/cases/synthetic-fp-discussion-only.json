        { "type": "function", "function": { "name": "get_weather", "description": "Current weather for a city.", "parameters": { "type": "object", "properties": { "city": { "type": "string" } }, "required": ["city"] } } }
      ]
    },
    "rawResponse": {
      "id": "chatcmpl-synthetic-fp",
      "object": "chat.completion",
      "model": "synthetic/qwen3",
      "choices": [
        {
          "index": 0,
          "finish_reason": "stop",
          "message": {
            "role": "assistant",
            "content": "I could call get_weather for Tokyo, but I do not need it for this answer.",
            "tool_calls": []
          }
        }
      ]
    }
  }
}
