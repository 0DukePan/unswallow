    "sglang",
    "llama.cpp",
    "qwen3",
    "deepseek",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "unswallow": "dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0DukePan/unswallow.git"
  },
  "homepage": "https://github.com/0DukePan/unswallow#readme",
  "bugs": {
    "url": "https://github.com/0DukePan/unswallow/issues"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "unswallow-matrix": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
